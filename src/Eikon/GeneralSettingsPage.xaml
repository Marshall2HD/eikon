<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Eikon.GeneralSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Eikon"
    Background="Transparent"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded">
    <Page.Resources>
        <Style TargetType="ToggleSwitch" BasedOn="{StaticResource SettingsToggleSwitchStyle}" />
        <Style TargetType="ComboBox" BasedOn="{StaticResource SettingsComboBoxStyle}" />
        <Style TargetType="CheckBox" BasedOn="{StaticResource DefaultCheckBoxStyle}">
            <Setter Property="MinWidth" Value="0" />
        </Style>
        <Style TargetType="RadioButton" BasedOn="{StaticResource DefaultRadioButtonStyle}">
            <Setter Property="MinWidth" Value="0" />
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock x:Uid="Prefs_GeneralHeader" Style="{StaticResource SettingsPageHeaderTextStyle}" AutomationProperties.HeadingLevel="Level1" />

        <ScrollViewer Grid.Row="1" Style="{StaticResource SettingsPageScrollViewerStyle}">
            <StackPanel Style="{StaticResource SettingsPageContentStyle}">

                <!-- ===== Window background ===== -->
                <Grid Style="{StaticResource SettingsCardGridStyle}" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock x:Uid="Prefs_WindowBackground" VerticalAlignment="Center" Style="{StaticResource BodyTextBlockStyle}" />
                        <Button x:Name="WindowBackgroundHelp" Style="{StaticResource PrefsHelpButtonStyle}" Tag="Prefs_HelpWindowBackground" Click="Help_Click" />
                    </StackPanel>
                    <StackPanel x:Name="BackgroundPanel" Grid.Row="1" Orientation="Horizontal" Spacing="20" />
                </Grid>

                <!-- ===== Save ===== -->
                <local:SettingsCard x:Uid="Prefs_ScreenshotsFolder" Margin="0,20,0,0">
                    <Button x:Name="SaveFolderButton" MinWidth="216" MaxWidth="320" Click="SaveFolderButton_Click">
                        <TextBlock x:Name="SaveFolderText" TextTrimming="CharacterEllipsis" />
                    </Button>
                </local:SettingsCard>
                <local:SettingsCard x:Uid="Prefs_SaveFormat">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <!-- Candy: the radio pair as a segmented control (same buttons, same setting). -->
                        <Border Style="{StaticResource CandySegmentWellStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <RadioButton x:Name="SaveFormatPng" x:Uid="Prefs_SaveFormatPng" GroupName="SaveFormat" Checked="SaveFormat_Checked"
                                             Style="{StaticResource CandySegmentRadioStyle}" />
                                <RadioButton x:Name="SaveFormatAuto" x:Uid="Prefs_SaveFormatAuto" GroupName="SaveFormat" Checked="SaveFormat_Checked"
                                             Style="{StaticResource CandySegmentRadioStyle}" />
                            </StackPanel>
                        </Border>
                        <Button Style="{StaticResource PrefsHelpButtonStyle}" Tag="Prefs_HelpSaveFormat" Click="Help_Click" />
                    </StackPanel>
                </local:SettingsCard>
                <local:SettingsCard x:Uid="Prefs_Downscale">
                    <ToggleSwitch x:Name="DownscaleToggle" Toggled="DownscaleToggle_Toggled" />
                </local:SettingsCard>

                <!-- ===== Scrolling ===== -->
                <local:SettingsCard x:Uid="Prefs_ScrollingMax" Margin="0,20,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox x:Name="ScrollingMaxBox" Width="96" InputScope="Number" KeyDown="ScrollingMaxBox_KeyDown" LostFocus="ScrollingMaxBox_LostFocus" />
                        <TextBlock x:Uid="Prefs_Px" VerticalAlignment="Center" />
                    </StackPanel>
                </local:SettingsCard>
                <local:SettingsCard x:Uid="Prefs_ScrollingSpeed">
                    <Slider
                        x:Name="ScrollingSpeedSlider"
                        Width="190"
                        Minimum="0"
                        Maximum="3"
                        StepFrequency="1"
                        TickFrequency="1"
                        TickPlacement="Outside"
                        SnapsTo="Ticks"
                        IsThumbToolTipEnabled="False"
                        ValueChanged="ScrollingSpeedSlider_ValueChanged" />
                </local:SettingsCard>

                <!-- ===== Behaviour ===== -->
                <local:SettingsCard x:Uid="Prefs_Autostart" Margin="0,20,0,0">
                    <ToggleSwitch x:Name="AutostartToggle" Toggled="AutostartToggle_Toggled" />
                </local:SettingsCard>
                <local:SettingsCard x:Uid="Prefs_AfterScreenshot">
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <CheckBox x:Name="AfterShowCheck" x:Uid="Prefs_AfterShow" Click="AfterGrab_Click" />
                        <CheckBox x:Name="AfterCopyCheck" x:Uid="Prefs_AfterCopy" Click="AfterGrab_Click" />
                        <CheckBox x:Name="AfterSaveCheck" x:Uid="Prefs_AfterSave" Click="AfterGrab_Click" />
                    </StackPanel>
                </local:SettingsCard>
                <local:SettingsCard x:Name="AreaCropCard" x:Uid="Prefs_AfterAreaCrop">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <RadioButton x:Name="AreaThumbnailRadio" x:Uid="Prefs_AreaThumbnail" GroupName="AreaCrop" Checked="AreaCrop_Checked" />
                        <RadioButton x:Name="AreaEditorRadio" x:Uid="Prefs_AreaEditor" GroupName="AreaCrop" Checked="AreaCrop_Checked" />
                    </StackPanel>
                </local:SettingsCard>
                <local:SettingsCard x:Name="ThumbnailClosingCard" x:Uid="Prefs_ThumbnailClosing">
                    <ComboBox x:Name="ThumbnailClosingCombo" SelectionChanged="ThumbnailClosingCombo_SelectionChanged">
                        <ComboBoxItem x:Uid="Prefs_ClosingAuto" />
                        <ComboBoxItem x:Uid="Prefs_ClosingManual" />
                    </ComboBox>
                </local:SettingsCard>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

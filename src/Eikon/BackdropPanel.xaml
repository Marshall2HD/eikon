<?xml version="1.0" encoding="utf-8"?>
<!-- The backdrop panel: 298 wide, a 258-wide vertical stack at (20, 20) with spacing 18. -->
<UserControl
    x:Class="Eikon.BackdropPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="298"
    FontSize="13">
    <UserControl.Resources>
        <Style x:Key="PanelSliderStyle" TargetType="Slider">
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="20" />
            <Setter Property="StepFrequency" Value="0.01" />
            <Setter Property="SmallChange" Value="1.2" />
            <Setter Property="LargeChange" Value="2" />
            <Setter Property="IsThumbToolTipEnabled" Value="False" />
            <Setter Property="Width" Value="119" />
            <Setter Property="Height" Value="24" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- 20 px high, so the inner-segment radius (6): 8 would read as a capsule. -->
        <Style x:Key="SmallButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style x:Key="SegmentStyle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
    </UserControl.Resources>

    <StackPanel x:Name="RootStack" Width="258" Margin="20,16,20,20" Spacing="18">

        <!-- Row 1: Backdrop + aspect pull-down + padding slider | Shadow + slider (258 × 44). -->
        <Canvas Width="258" Height="44">
            <TextBlock x:Uid="BackdropPanel_Title" Canvas.Left="0" Canvas.Top="0" />
            <Button
                x:Name="AspectButton"
                x:Uid="BackdropPanel_Aspect"
                Canvas.Left="61"
                Canvas.Top="1"
                Width="58"
                Height="16"
                MinHeight="0"
                MinWidth="0"
                Padding="0"
                CornerRadius="4"
                FontSize="11"
                Background="Transparent"
                BorderThickness="0"
                Content="•••">
                <Button.Flyout>
                    <MenuFlyout x:Name="AspectMenu" Placement="BottomEdgeAlignedLeft" />
                </Button.Flyout>
            </Button>
            <Slider
                x:Name="PaddingSlider"
                x:Uid="BackdropPanel_PaddingSlider"
                Canvas.Left="0"
                Canvas.Top="20"
                Style="{StaticResource PanelSliderStyle}"
                ValueChanged="PaddingSlider_ValueChanged" />
            <TextBlock x:Uid="BackdropPanel_Shadow" Canvas.Left="139" Canvas.Top="0" />
            <Slider
                x:Name="ShadowSlider"
                x:Uid="BackdropPanel_ShadowSlider"
                Canvas.Left="139"
                Canvas.Top="16"
                Style="{StaticResource PanelSliderStyle}"
                ValueChanged="ShadowSlider_ValueChanged" />
        </Canvas>

        <!-- Row 2: Inset + Recenter + slider (258 × 40). -->
        <Canvas Width="258" Height="40">
            <TextBlock x:Uid="BackdropPanel_Inset" Canvas.Left="0" Canvas.Top="0" />
            <Button
                x:Uid="BackdropPanel_Recenter"
                Canvas.Left="69"
                Canvas.Top="-2"
                Width="54"
                Height="20"
                Style="{StaticResource SmallButtonStyle}"
                Click="Recenter_Click" />
            <Slider
                x:Name="InsetSlider"
                x:Uid="BackdropPanel_InsetSlider"
                Canvas.Left="0"
                Canvas.Top="18"
                Style="{StaticResource PanelSliderStyle}"
                ValueChanged="InsetSlider_ValueChanged" />
        </Canvas>

        <!-- Row 3: Outer Radius | Inner Radius (258 × 40). -->
        <Canvas Width="258" Height="40">
            <TextBlock x:Uid="BackdropPanel_OuterRadius" Canvas.Left="0" Canvas.Top="0" />
            <Slider
                x:Name="OuterRadiusSlider"
                x:Uid="BackdropPanel_OuterRadiusSlider"
                Canvas.Left="0"
                Canvas.Top="18"
                Style="{StaticResource PanelSliderStyle}"
                ValueChanged="OuterRadiusSlider_ValueChanged" />
            <TextBlock x:Uid="BackdropPanel_InnerRadius" Canvas.Left="139" Canvas.Top="0" />
            <Slider
                x:Name="InnerRadiusSlider"
                x:Uid="BackdropPanel_InnerRadiusSlider"
                Canvas.Left="139"
                Canvas.Top="16"
                Style="{StaticResource PanelSliderStyle}"
                ValueChanged="InnerRadiusSlider_ValueChanged" />
        </Canvas>

        <!-- Mode segments and the groups (only the active group is shown). -->
        <StackPanel Width="258">
            <Grid x:Name="ModeTabs" Width="258" Height="24" Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ToggleButton
                    x:Name="SolidTab"
                    x:Uid="BackdropPanel_Solid"
                    Grid.Column="0"
                    CornerRadius="8,0,0,8"
                    Style="{StaticResource SegmentStyle}"
                    Click="ModeTab_Click"
                    Tag="0" />
                <ToggleButton
                    x:Name="ColormixTab"
                    x:Uid="BackdropPanel_Colormix"
                    Grid.Column="1"
                    CornerRadius="0"
                    Style="{StaticResource SegmentStyle}"
                    Click="ModeTab_Click"
                    Tag="1" />
                <ToggleButton
                    x:Name="ImageTab"
                    x:Uid="BackdropPanel_Image"
                    Grid.Column="2"
                    CornerRadius="0,8,8,0"
                    Style="{StaticResource SegmentStyle}"
                    Click="ModeTab_Click"
                    Tag="2" />
            </Grid>

            <StackPanel Width="258" Margin="0,10,0,0">
                <!-- groupSolid: wsSolids, 30 × 30 swatches, gap 8. -->
                <StackPanel x:Name="SolidGroup" Width="258">
                    <StackPanel x:Name="SolidSwatches" Spacing="8" />
                </StackPanel>

                <!-- groupColormix: wsGradients (37 × 36, gap 7), the custom-gradient box, then the
                     gradient type popup with revert and randomize. -->
                <StackPanel x:Name="ColormixGroup" Width="258" Spacing="10">
                    <StackPanel Spacing="10">
                        <StackPanel x:Name="GradientSwatches" Spacing="7" />
                        <Border
                            x:Name="CustomGradBox"
                            Width="258"
                            Height="38"
                            Visibility="Collapsed"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                            <Canvas Width="258" Height="38">
                                <Grid x:Name="GradFromSwatch" Canvas.Left="8" Canvas.Top="6" Width="44" Height="24" />
                                <TextBlock Canvas.Left="56" Canvas.Top="9" Width="16" Text="→" TextAlignment="Center" />
                                <Grid x:Name="GradToSwatch" Canvas.Left="76" Canvas.Top="6" Width="44" Height="24" />
                                <Button
                                    x:Uid="BackdropPanel_CustomGradOk"
                                    Canvas.Left="210"
                                    Canvas.Top="6"
                                    Width="40"
                                    Height="24"
                                    MinHeight="0"
                                    MinWidth="0"
                                    Padding="0"
                                    Click="CustomGradOk_Click" />
                            </Canvas>
                        </Border>
                    </StackPanel>
                    <Canvas Width="258" Height="24">
                        <ComboBox
                            x:Name="GradientTypeBox"
                            x:Uid="BackdropPanel_GradientType"
                            Canvas.Left="0"
                            Canvas.Top="0"
                            Width="181"
                            Height="24"
                            MinHeight="0"
                            Padding="8,0,0,0"
                            FontSize="13"
                            SelectionChanged="GradientType_SelectionChanged">
                            <ComboBoxItem x:Uid="BackdropPanel_MeshGradient" />
                            <ComboBoxItem x:Uid="BackdropPanel_VerticalGradient" />
                            <ComboBoxItem x:Uid="BackdropPanel_DiagonalGradient" />
                            <ComboBoxItem x:Uid="BackdropPanel_RadialGradient" />
                        </ComboBox>
                        <Button
                            x:Name="RevertButton"
                            x:Uid="BackdropPanel_Reverse"
                            Canvas.Left="189"
                            Canvas.Top="0"
                            Width="30"
                            Height="24"
                            Style="{StaticResource SmallButtonStyle}"
                            Click="Reverse_Click">
                            <BitmapIcon Width="20" Height="20" ShowAsMonochrome="True" UriSource="ms-appx:///Assets/ico-20-revert.png" />
                        </Button>
                        <Button
                            x:Name="RandomizeButton"
                            x:Uid="BackdropPanel_Randomize"
                            Canvas.Left="227"
                            Canvas.Top="0"
                            Width="30"
                            Height="24"
                            Style="{StaticResource SmallButtonStyle}"
                            Click="Randomize_Click">
                            <BitmapIcon Width="20" Height="20" ShowAsMonochrome="True" UriSource="ms-appx:///Assets/ico-20-randomize.png" />
                        </Button>
                    </Canvas>
                </StackPanel>

                <!-- groupImage: wsImages (57 × 38, gap 10), then Image Blur (0…7, 8 ticks). -->
                <StackPanel x:Name="ImageGroup" Width="258" Spacing="12">
                    <StackPanel x:Name="ImageSwatches" Spacing="10" />
                    <Canvas Width="258" Height="16">
                        <TextBlock x:Uid="BackdropPanel_ImageBlur" Canvas.Left="0" Canvas.Top="-1" />
                        <Slider
                            x:Name="BlurSlider"
                            x:Uid="BackdropPanel_BlurSlider"
                            Canvas.Left="89"
                            Canvas.Top="-4"
                            Width="169"
                            Height="24"
                            MinHeight="0"
                            Minimum="0"
                            Maximum="7"
                            StepFrequency="1"
                            SmallChange="1"
                            TickFrequency="1"
                            TickPlacement="Outside"
                            SnapsTo="Ticks"
                            IsThumbToolTipEnabled="False"
                            ValueChanged="BlurSlider_ValueChanged" />
                    </Canvas>
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <!-- Remove | Ok (Return). -->
        <Canvas Width="258" Height="24">
            <Button
                x:Uid="BackdropPanel_Remove"
                Canvas.Left="121"
                Canvas.Top="0"
                Width="73"
                Height="24"
                MinHeight="0"
                Padding="0"
                Style="{StaticResource CandyGhostButtonStyle}"
                FontWeight="SemiBold"
                FontSize="12"
                Click="Remove_Click" />
            <Button
                x:Name="OkButton"
                x:Uid="BackdropPanel_Ok"
                Canvas.Left="206"
                Canvas.Top="0"
                Width="52"
                Height="24"
                MinHeight="0"
                Padding="0"
                Style="{StaticResource CandyInkButtonStyle}"
                FontSize="12"
                Click="Ok_Click" />
            <!-- Return: the panel's PreviewKeyDown (it must win over the focused button). -->
        </Canvas>
    </StackPanel>
</UserControl>

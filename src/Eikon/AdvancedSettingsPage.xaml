<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Eikon.AdvancedSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Eikon"
    Background="Transparent"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded">
    <Page.Resources>
        <Style TargetType="ToggleSwitch" BasedOn="{StaticResource SettingsToggleSwitchStyle}" />
        <Style TargetType="ComboBox" BasedOn="{StaticResource SettingsComboBoxStyle}" />
        <Style TargetType="CheckBox" BasedOn="{StaticResource DefaultCheckBoxStyle}">
            <Setter Property="MinWidth" Value="0" />
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock x:Uid="Prefs_AdvancedHeader" Style="{StaticResource SettingsPageHeaderTextStyle}" AutomationProperties.HeadingLevel="Level1" />

        <ScrollViewer Grid.Row="1" Style="{StaticResource SettingsPageScrollViewerStyle}">
            <!-- Rows 1-11. -->
            <StackPanel Style="{StaticResource SettingsPageContentStyle}">
                <local:SettingsCard x:Uid="Prefs_OcrLanguage">
                    <ComboBox x:Name="OcrLanguageCombo" MinWidth="166" SelectionChanged="OcrLanguageCombo_SelectionChanged" />
                </local:SettingsCard>
                <local:SettingsCard x:Uid="Prefs_OcrBreaks">
                    <ToggleSwitch x:Name="OcrBreaksToggle" Toggled="Toggle_Toggled" />
                </local:SettingsCard>
                <local:SettingsCard x:Uid="Prefs_TrayIcon">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Style="{StaticResource PrefsHelpButtonStyle}" Tag="Prefs_HelpRestart" Click="Help_Click" />
                        <ToggleSwitch x:Name="HideTrayToggle" Toggled="Toggle_Toggled" />
                    </StackPanel>
                </local:SettingsCard>
                <local:SettingsCard x:Uid="Prefs_Splash">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Style="{StaticResource PrefsHelpButtonStyle}" Tag="Prefs_HelpRestart" Click="Help_Click" />
                        <ToggleSwitch x:Name="HideSplashToggle" Toggled="Toggle_Toggled" />
                    </StackPanel>
                </local:SettingsCard>
                <local:SettingsCard x:Uid="Prefs_MainWindow">
                    <ToggleSwitch x:Name="AlwaysOnTopToggle" Toggled="Toggle_Toggled" />
                </local:SettingsCard>
                <local:SettingsCard x:Uid="Prefs_ZoomWheel">
                    <ToggleSwitch x:Name="ZoomDirectionToggle" Toggled="Toggle_Toggled" />
                </local:SettingsCard>
                <local:SettingsCard x:Uid="Prefs_ScrollingCapture">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Style="{StaticResource PrefsHelpButtonStyle}" Tag="Prefs_HelpReverseAutoscroll" Click="Help_Click" />
                        <ToggleSwitch x:Name="ReverseAutoscrollToggle" Toggled="Toggle_Toggled" />
                    </StackPanel>
                </local:SettingsCard>
                <local:SettingsCard x:Uid="Prefs_DefaultZoom">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Style="{StaticResource PrefsHelpButtonStyle}" Tag="Prefs_HelpLargerWindow" Click="Help_Click" />
                        <ToggleSwitch x:Name="PreferLargeToggle" Toggled="Toggle_Toggled" />
                    </StackPanel>
                </local:SettingsCard>
                <local:SettingsCard x:Uid="Prefs_EscAction">
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <CheckBox x:Name="EscCopyCheck" x:Uid="Prefs_EscCopy" Click="EscCheck_Click" />
                        <CheckBox x:Name="EscSaveCheck" x:Uid="Prefs_EscSave" Click="EscCheck_Click" />
                    </StackPanel>
                </local:SettingsCard>
                <local:SettingsCard x:Uid="Prefs_Confirmation">
                    <ComboBox x:Name="ConfirmationCombo" SelectionChanged="ConfirmationCombo_SelectionChanged">
                        <ComboBoxItem x:Uid="Prefs_NotifyCustom" Tag="custom" />
                        <ComboBoxItem x:Uid="Prefs_NotifySystem" Tag="system" />
                        <ComboBoxItem x:Uid="Prefs_NotifyNone" Tag="none" />
                    </ComboBox>
                </local:SettingsCard>
                <local:SettingsCard x:Uid="Prefs_Deeplinks">
                    <ToggleSwitch x:Name="DeeplinksToggle" Toggled="Toggle_Toggled" />
                </local:SettingsCard>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

    <AppxManifest Include="Package.appxmanifest">
      <SubType>Designer</SubType>
    </AppxManifest>
  </ItemGroup>
  <!--
    Source files are picked up by convention so that new files only need to be dropped into the
    right place:
      * Core\, Platform\, Editor\   plain C++ (.h/.cpp), no XAML (Editor\ may use Win2D)
      * project root        WinRT runtime classes (*.idl), XAML windows/pages/controls (*.xaml with
                            *.xaml.h/*.xaml.cpp code-behind) and their view models. XAML must stay in
                            the project root so that C++/WinRT finds the generated *.xaml.g.h files.
  -->
  <ItemGroup>
    <!-- Headers of non-XAML runtime classes must name their .idl in DependentUpon, otherwise the XAML
         compiler cannot include them in XamlTypeInfo.g.cpp when the class is used in markup. -->
    <ClInclude Include="*.h;Core\**\*.h;Platform\**\*.h;Editor\**\*.h" Exclude="*.xaml.h;SettingsCard.h" />
    <ClInclude Include="SettingsCard.h">
      <DependentUpon>SettingsCard.idl</DependentUpon>
    </ClInclude>
    <ClInclude Include="*.xaml.h">
      <DependentUpon>%(Filename)</DependentUpon>
    </ClInclude>
  </ItemGroup>
  <ItemGroup>
    <ApplicationDefinition Include="App.xaml" />
    <Page Include="*.xaml;Themes\*.xaml" Exclude="App.xaml" />
  </ItemGroup>
  <ItemGroup>
    <ClCompile Include="pch.cpp">
      <PrecompiledHeader>Create</PrecompiledHeader>
    </ClCompile>
    <ClCompile Include="*.cpp;Core\**\*.cpp;Platform\**\*.cpp;Editor\**\*.cpp" Exclude="pch.cpp;*.xaml.cpp;SettingsCard.cpp" />
    <ClCompile Include="SettingsCard.cpp">
      <DependentUpon>SettingsCard.idl</DependentUpon>
    </ClCompile>
    <ClCompile Include="*.xaml.cpp">
      <DependentUpon>%(Filename)</DependentUpon>
    </ClCompile>
    <ClCompile Include="$(GeneratedFilesDir)module.g.cpp" />
  </ItemGroup>
  <ItemGroup>
    <Midl Include="*.idl">
      <SubType>Code</SubType>
    </Midl>
  </ItemGroup>
  <ItemGroup>
    <Image Include="Assets\*.png" />
    <!-- Editor images: Image items are what the MSIX layout picks up. -->
    <Image Include="Assets\Editor\*.png" />
    <!-- The window and fallback tray icon, loaded at runtime: an Image item too (Content items are not in the MSIX). -->
    <Image Include="Assets\*.ico" />
    <!-- Thumbnail, pin and notification images. -->
    <Image Include="Assets\Preview\*.png" />
    <!-- 16-menu-* (tray menu) and eikon-22* (status icon) images, loaded at runtime from the
         package folder: Image items, because Content items in subfolders are not in the MSIX. -->
    <Image Include="Assets\Menu\*.png;Assets\Tray\*.png" />
    <!-- Library and Preferences images: Image items are what the MSIX layout picks up. -->
    <Image Include="Assets\Library\*.png;Assets\Prefs\*.png" />
    <!-- The drawn zoom and pen cursor masters (Editor/Cursors scales them at runtime). -->
    <Image Include="Assets\Cursors\*.png" />
  </ItemGroup>
  <ItemGroup>
    <ResourceCompile Include="Eikon.rc" />
  </ItemGroup>
  <ItemGroup>
    <PRIResource Include="Strings\**\*.resw" />
  </ItemGroup>
  <!-- QR detection for OCR (third_party/zxing-cpp/README.eikon.md). -->
  <ItemGroup>
    <ProjectReference Include="..\..\third_party\zxing-cpp\ZXing.vcxproj">
      <Project>{3f925e22-bc57-43c8-9642-b9d802374ab3}</Project>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnablePreviewMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
